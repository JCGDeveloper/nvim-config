// ══════════════════════════════════════════════════════════════════════════
//  keybindings.json para vscode-neovim (migrado desde tu config de VSCodeVim).
//
//  Aquí va SOLO lo que VSCode intercepta antes que Neovim: Ctrl/Tab/Esc y los
//  atajos de letra DENTRO del explorador. Tus atajos de leader (space ...)
//  viven en el init.lua dedicado.
//
//  Cambio clave respecto a tu versión: el context key de modo pasó de
//  'vim.mode' (VSCodeVim) a 'neovim.mode' (vscode-neovim). Si la navegación no
//  respondiera en tu versión, quitá la parte "&& neovim.mode == 'normal'".
// ══════════════════════════════════════════════════════════════════════════
[
  // ── WhichKey: popup de atajos al apretar espacio en modo normal ──
  //    Requiere la extensión VSpaceCode.whichkey. El menú está en settings.json
  //    ("whichkey.bindings") y reenvía las teclas a Neovim (vscode-neovim.send),
  //    así los mappings del init.lua siguen siendo la única fuente de verdad.
  {
    "key": "space",
    "command": "whichkey.show",
    "when": "editorTextFocus && neovim.init && neovim.mode != 'insert'"
  },
  // ── Navegación entre ventanas (tu Ctrl+hjkl tmux) ──
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  // ── Mover editor entre grupos (tu Ctrl+Shift+hjkl) ──
  {
    "key": "ctrl+shift+h",
    "command": "workbench.action.moveEditorToLeftGroup",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+shift+l",
    "command": "workbench.action.moveEditorToRightGroup",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+shift+k",
    "command": "workbench.action.moveEditorToAboveGroup",
    "when": "neovim.mode == 'normal'"
  },
  {
    "key": "ctrl+shift+j",
    "command": "workbench.action.moveEditorToBelowGroup",
    "when": "neovim.mode == 'normal'"
  },
  //TODO:Pruebas
  // ── Redimensionar ventanas (tu Ctrl+Alt+hjkl) ──
  {
    "key": "ctrl+alt+h",
    "command": "workbench.action.decreaseViewWidth",
    "when": "neovim.mode == 'normal' && !inputFocus"
  },
  {
    "key": "ctrl+alt+l",
    "command": "workbench.action.increaseViewWidth",
    "when": "neovim.mode == 'normal' && !inputFocus"
  },
  {
    "key": "ctrl+alt+k",
    "command": "workbench.action.decreaseViewHeight",
    "when": "neovim.mode == 'normal' && !inputFocus"
  },
  {
    "key": "ctrl+alt+j",
    "command": "workbench.action.increaseViewHeight",
    "when": "neovim.mode == 'normal' && !inputFocus"
  },
  // ── Pestañas dentro del grupo (tu Tab / Shift+Tab) ──
  {
    "key": "tab",
    "command": "workbench.action.nextEditorInGroup",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  {
    "key": "shift+tab",
    "command": "workbench.action.previousEditorInGroup",
    "when": "editorTextFocus && neovim.mode == 'normal'"
  },
  // ── Panel inferior: navegar entre sus pestañas (Terminal, Problems, ...) ──
  //    Con el foco en el panel: Alt+, / Alt+. van a la pestaña anterior/siguiente
  //    (no usamos Alt+h/l porque GlazeWM se queda Alt+hjkl para el foco de ventanas)
  {
    "key": "alt+,",
    "command": "workbench.action.previousPanelView",
    "when": "panelFocus"
  },
  {
    "key": "alt+.",
    "command": "workbench.action.nextPanelView",
    "when": "panelFocus"
  },
  // ── Multicursor (tu Ctrl+n) ──
  {
    "key": "ctrl+n",
    "command": "editor.action.addSelectionToNextFindMatch",
    "when": "editorTextFocus"
  },
  // ── Aceptar sugerencia IA (tu Alt+Enter) ──
  {
    "key": "alt+enter",
    "command": "editor.action.inlineSuggest.commit",
    "when": "inlineSuggestionVisible"
  },
  // ── SAP: Ctrl+G como en Eclipse — abre el GUI embebido del objeto actual ──
  //    Solo en archivos ABAP remotos (adt); en el resto, Ctrl+G sigue siendo "ir a línea"
  {
    "key": "ctrl+g",
    "command": "abapfs.runInEmbeddedGui",
    "when": "editorTextFocus && resourceScheme == 'adt' && neovim.mode == 'normal'"
  },
  // ── Ctrl+Q cierra el editor/webview activo (salir del SAP GUI embebido) ──
  //    Global y sin 'when': los webviews de abapfs no siempre activan los
  //    context keys estándar. Quitamos antes el default (picker de vistas).
  {
    "key": "ctrl+q",
    "command": "-workbench.action.quickOpenView"
  },
  {
    "key": "ctrl+q",
    "command": "workbench.action.closeActiveEditor"
  },
  // ── ...y con el foco en el panel de chat IA, Ctrl+Q cierra ese panel ──
  {
    "key": "ctrl+q",
    "command": "workbench.action.closeAuxiliaryBar",
    "when": "auxiliaryBarFocus"
  },
  // ── Salir del panel de chat IA (sidebar secundario) con Ctrl+l ──
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "auxiliaryBarFocus"
  },
  // ── Salir del sidebar con Esc / Ctrl+l (tus parches) ──
  {
    "key": "escape",
    "command": "workbench.action.toggleSidebarVisibility",
    "when": "sideBarVisible && sideBarFocus"
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.focusActiveEditorGroup",
    "when": "sideBarVisible && sideBarFocus"
  },
  // ── Atajos dentro del explorador de archivos (tus r/c/p/x/d/a/s) ──
  {
    "key": "r",
    "command": "renameFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "c",
    "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "p",
    "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "x",
    "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "d",
    "command": "deleteFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "a",
    "command": "explorer.newFile",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "s",
    "command": "explorer.openToSide",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "shift+s",
    "command": "runCommands",
    "args": {
      "commands": [
        "workbench.action.splitEditorDown",
        "explorer.openAndPassFocus",
        "workbench.action.closeOtherEditors"
      ]
    },
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceReadonly && !inputFocus"
  },
  {
    "key": "enter",
    "command": "explorer.openAndPassFocus",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && !explorerResourceIsFolder && !inputFocus"
  },
  {
    "key": "enter",
    "command": "list.toggleExpand",
    "when": "filesExplorerFocus && foldersViewVisible && !explorerResourceIsRoot && explorerResourceIsFolder && !inputFocus"
  },
  // ── Debugger estilo SAP GUI ──
  //    Replica las teclas del debugger de SAP GUI: F5 step into, F6 step over,
  //    F7 step return, F8 continuar. Solo se activan estando PARADO en un
  //    breakpoint (debugState == 'stopped'), así que fuera del debug F5/F8/etc.
  //    siguen haciendo lo de siempre. Son funciones, Neovim no las captura.
  {
    "key": "f5",
    "command": "workbench.action.debug.stepInto",
    "when": "inDebugMode && debugState == 'stopped'"
  },
  {
    "key": "f6",
    "command": "workbench.action.debug.stepOver",
    "when": "inDebugMode && debugState == 'stopped'"
  },
  {
    "key": "f7",
    "command": "workbench.action.debug.stepOut",
    "when": "inDebugMode && debugState == 'stopped'"
  },
  {
    "key": "f8",
    "command": "workbench.action.debug.continue",
    "when": "inDebugMode && debugState == 'stopped'"
  }
]