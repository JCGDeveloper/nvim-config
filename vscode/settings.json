{
  // ════════════════════════════════════════════════════════════════════════
  //  settings.json — VSCode + vscode-neovim, estilo "tu nvim" (al máximo).
  //  Fusioná estas claves con tu settings (Ctrl+Shift+P → Open User Settings JSON).
  //  Requiere: extensiones Kanagawa (qufiwefefwoyn.kanagawa),
  //  GlassIt (s-nlf-fh.glassit) y la fuente JetBrainsMono Nerd Font. Ver README.
  // ════════════════════════════════════════════════════════════════════════

  // ── Motor Neovim ─────────────────────────────────────────────────────────
  "extensions.experimental.affinity": { "asvetliakov.vscode-neovim": 1 },
  "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",

  // ── Theme + transparencia ────────────────────────────────────────────────
  "workbench.colorTheme": "Kanagawa",
  "glassit.alpha": 245, // 255 = opaco. Ajustá con Ctrl+Alt+Z / Ctrl+Alt+C.

  // ── Fuente (JetBrainsMono Nerd Font + ligaduras) ─────────────────────────
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.lineHeight": 1.5,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",

  // ── Cursor animado (smear) + scroll suave ────────────────────────────────
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,

  // ── Brackets de colores + guías ──────────────────────────────────────────
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,

  // ── SIN barra de título ni icono de VSCode (lo más nvim) ─────────────────
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "never",
  "window.menuBarVisibility": "hidden",

  // ── UI a cero, statusline visible (tu lualine) ───────────────────────────
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "none",
  "workbench.layoutControl.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.tips.enabled": false,
  "workbench.startupEditor": "none",
  "breadcrumbs.enabled": false,
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.glyphMargin": false,
  "editor.renderLineHighlight": "none",
  "editor.scrollBeyondLastLine": false,

  // ── Aire / padding (que respire como tu nvim) ────────────────────────────
  "editor.padding.top": 18,
  "editor.padding.bottom": 18,

  // ── Explorador minimalista (estilo oil/neo-tree) ─────────────────────────
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "none",
  "explorer.compactFolders": false,
  "explorer.decorations.badges": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  // ── Estilo tipo nvim ─────────────────────────────────────────────────────
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 8,

  // ── Colores finos (kanagawa-like, bordes invisibles) ─────────────────────
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#C8C093",
    "editorLineNumber.foreground": "#54546D",
    "editorLineNumber.activeForeground": "#C8C093",
    "editor.selectionBackground": "#2D4F6755",
    "editor.lineHighlightBorder": "#00000000",
    "focusBorder": "#00000000",
    "editorGroup.border": "#00000000",
    "sideBar.border": "#00000000",
    "statusBar.border": "#00000000",
    "panel.border": "#00000000",
    "tab.border": "#00000000",
    "editorWidget.border": "#00000000"
  },

  // ── Comportamiento ───────────────────────────────────────────────────────
  "files.autoSave": "off",
  "editor.formatOnSave": false
}
