      ]
    },
    {
      "key": "f", "name": "📁 +Archivo/Terminal", "type": "bindings", "bindings": [
        { "key": "t", "name": "💻 Toggle terminal", "type": "command", "command": "vscode-neovim.send", "args": "<space>ft" },
        { "key": "T", "name": "➕ Nueva terminal", "type": "command", "command": "workbench.action.terminal.new" },
        { "key": "n", "name": "🆕 Nuevo archivo", "type": "command", "command": "workbench.action.files.newUntitledFile" },
        { "key": "r", "name": "🕘 Recientes (archivos/carpetas)", "type": "command", "command": "workbench.action.openRecent" },
        { "key": "s", "name": "💾 Guardar todo", "type": "command", "command": "workbench.action.files.saveAll" }
