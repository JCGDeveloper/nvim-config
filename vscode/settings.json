    {
      "key": "s", "name": "🔎 +Buscar/Split", "type": "bindings", "bindings": [
        { "key": "h", "name": "➡️ Split derecha", "type": "command", "command": "vscode-neovim.send", "args": "<space>sh" },
        { "key": "v", "name": "⬇️ Split abajo", "type": "command", "command": "vscode-neovim.send", "args": "<space>sv" },
        { "key": "g", "name": "🔎 Buscar texto (teclado)", "type": "command", "command": "vscode-neovim.send", "args": "<space>sg" },
        { "key": "G", "name": "🗂️ Buscar en archivos (panel)", "type": "command", "command": "vscode-neovim.send", "args": "<space>sG" },
        { "key": "t", "name": "📌 Lista de TODOs", "type": "command", "command": "vscode-neovim.send", "args": "<space>st" },
        { "key": "n", "name": "⏭️ TODO siguiente (archivo)", "type": "command", "command": "todo-tree.goToNext" },
