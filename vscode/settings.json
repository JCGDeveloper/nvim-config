{
  // ════════════════════════════════════════════════════════════════════════
  //  settings.json — VSCode + vscode-neovim, estilo "tu nvim" (al máximo).
  //  Fusioná estas claves con tu settings (Ctrl+Shift+P → Open User Settings JSON).
  //  Requiere: extensiones Kanagawa (qufiwefefwoyn.kanagawa),
  //  GlassIt (s-nlf-fh.glassit) y la fuente JetBrainsMono Nerd Font. Ver README.
  // ════════════════════════════════════════════════════════════════════════

  // ── Motor Neovim ─────────────────────────────────────────────────────────
  "extensions.experimental.affinity": { "asvetliakov.vscode-neovim": 1 },
  "vscode-neovim.neovimExecutablePaths.win32": "C:\\Program Files\\Neovim\\bin\\nvim.exe",

  // ── Theme + iconos + transparencia ───────────────────────────────────────
  "workbench.colorTheme": "Kanagawa",
  "workbench.iconTheme": "material-icon-theme", // iconos de archivos (como nvim-web-devicons)
  "glassit.alpha": 245, // 255 = opaco. Ajustá con Ctrl+Alt+Z / Ctrl+Alt+C.

  // ── Fuente (JetBrainsMono Nerd Font + ligaduras) ─────────────────────────
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Consolas, monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 15,
  "editor.lineHeight": 1.5,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font'",

  // ── Cursor animado (smear) + scroll suave ────────────────────────────────
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "expand",
  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,
  "terminal.integrated.smoothScrolling": true,

  // ── Brackets de colores + guías ──────────────────────────────────────────
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,

  // ── SIN barra de título, icono, command center ni menú (lo más nvim) ─────
  // OJO: estos cambios SOLO se aplican cerrando y reabriendo VSCode por
  // completo (NO con "Reload Window").
  "window.titleBarStyle": "custom",
  "window.customTitleBarVisibility": "never",
  "window.commandCenter": false,
  "window.menuBarVisibility": "hidden",
  // Sin mnemonics Alt+letra (Alt+H abría Help y pisaba Alt+h del panel).
  // El menú sigue accesible pulsando Alt a solas.
  "window.enableMenuBarMnemonics": false,

  // ── UI a cero, statusline visible (tu lualine) ───────────────────────────
  "workbench.activityBar.location": "hidden",
  "workbench.statusBar.visible": true,
  "workbench.editor.showTabs": "none",
  "workbench.layoutControl.enabled": false,
  "workbench.editor.editorActionsLocation": "hidden",
  "workbench.tips.enabled": false,
  "workbench.startupEditor": "welcomePage", // pantalla de inicio (lo más cercano al dashboard de LazyVim)
  "breadcrumbs.enabled": true, // nombre del archivo + ruta arriba (no hay pestañas)
  "breadcrumbs.icons": true,
  "breadcrumbs.symbolPath": "last",
  "editor.minimap.enabled": false,
  "editor.scrollbar.vertical": "hidden",
  "editor.scrollbar.horizontal": "hidden",
  "editor.overviewRulerBorder": false,
  "editor.hideCursorInOverviewRuler": true,
  "editor.glyphMargin": false,
  "editor.renderLineHighlight": "all", // resalta la línea actual (cursorline)
  "editor.scrollBeyondLastLine": false,

  // ── Aire / padding (que respire como tu nvim) ────────────────────────────
  "editor.padding.top": 18,
  "editor.padding.bottom": 18,

  // ── Explorador minimalista (estilo oil/neo-tree) ─────────────────────────
  "workbench.tree.indent": 14,
  "workbench.tree.renderIndentGuides": "none",
  "explorer.compactFolders": false,
  "explorer.decorations.badges": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmDelete": false,

  // ── Estilo tipo nvim ─────────────────────────────────────────────────────
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 8,

  // ── Colores finos (kanagawa-like, bordes invisibles) ─────────────────────
  "workbench.colorCustomizations": {
    "editorCursor.foreground": "#C8C093",
    "editorLineNumber.foreground": "#54546D",
    "editorLineNumber.activeForeground": "#C8C093",
    "editor.selectionBackground": "#2D4F6755",
    "editor.lineHighlightBackground": "#2A2A3766",
    "editor.lineHighlightBorder": "#00000000",
    "focusBorder": "#00000000",
    "editorGroup.border": "#00000000",
    "sideBar.border": "#00000000",
    "statusBar.border": "#00000000",
    "panel.border": "#00000000",
    "tab.border": "#00000000",
    "editorWidget.border": "#00000000",
    // QuickPick (popup de which-key y pickers) a juego con Kanagawa
    "quickInput.background": "#1F1F28",
    "quickInput.foreground": "#DCD7BA",
    "quickInputTitle.background": "#2A2A37",
    "quickInputList.focusBackground": "#2D4F67",
    "quickInputList.focusForeground": "#DCD7BA",
    "quickInputList.focusIconForeground": "#C8C093",
    "pickerGroup.foreground": "#957FB8",
    "pickerGroup.border": "#00000000",
    "widget.border": "#54546D",
    "widget.shadow": "#00000066"
  },

  // ── Comportamiento ───────────────────────────────────────────────────────
  "files.autoSave": "off",
  "editor.formatOnSave": true,        // formatear al guardar (como conform en nvim)
  "editor.inlayHints.enabled": "off", // como en tu config (inlay hints desactivados)

  // ── Todo Tree (resaltar TODO/FIXME/HACK en el código, como todo-comments) ─
  // ⚠️ Hacer que funcione con el ABAP remote filesystem (esquema adt://) tiene
  // 4 trampas. Ver "TODO Tree + Todo+ con SAP" en el README para el detalle.
  //
  // (1) Activar la extensión en workspaces virtuales (si no, VSCode la apaga):
  "extensions.supportVirtualWorkspaces": { "Gruntfuggly.todo-tree": true },
  // (2) Permitir el esquema adt:// (los objetos ABAP NO son file://). Sin esto
  //     el árbol dice "Nothing found" y no resalta nada. ESTA es la clave.
  "todo-tree.general.schemes": ["file", "ssh", "untitled", "vscode-notebook-cell", "adt"],
  // (3) Escanear los editores ABIERTOS (en remoto no hay archivos en disco que
  //     ripgrep pueda recorrer; en carpetas locales escanea todo igual).
  "todo-tree.tree.scanMode": "open files",
  // (4) Regex que reconoce los comentarios de ABAP: " inline  y  * de línea.
  //     OJO: sin "^" para que PERFORM y demás palabras no piquen como tags.
  "todo-tree.regex.regex": "(\\*|\"|//|#|<!--|;|/\\*)\\s*($TAGS)",
  "todo-tree.highlights.enabled": true,
  "todo-tree.general.tags": ["TODO", "FIXME", "FIX", "HACK", "BUG", "NOTE"],
  // Colores Kanagawa para el resaltado en el editor (tag-and-comment = pinta
  // el tag y el resto del comentario).
  "todo-tree.highlights.defaultHighlight": { "type": "tag-and-comment", "foreground": "#1F1F28", "fontWeight": "bold", "borderRadius": "3px" },
  "todo-tree.highlights.customHighlight": {
    "TODO":  { "background": "#7E9CD8", "iconColour": "#7E9CD8", "icon": "check" },
    "FIXME": { "background": "#E82424", "iconColour": "#E82424", "icon": "tools", "foreground": "#DCD7BA" },
    "FIX":   { "background": "#E82424", "iconColour": "#E82424", "icon": "tools", "foreground": "#DCD7BA" },
    "BUG":   { "background": "#FF5D62", "iconColour": "#FF5D62", "icon": "bug" },
    "HACK":  { "background": "#FF9E3B", "iconColour": "#FF9E3B", "icon": "flame" },
    "NOTE":  { "background": "#98BB6C", "iconColour": "#98BB6C", "icon": "note" }
  },
  // ⚠️ La clave correcta es "todo-tree.ripgrep.ripgrep" (NO "todo-tree.ripgrep",
  // que VSCode atenúa por no reconocerla). ripgrep de winget (BurntSushi.ripgrep
  // .MSVC); la carpeta lleva el nº de versión, así que al actualizar ripgrep
  // hay que rebuscar rg.exe con:  where.exe rg
  "todo-tree.ripgrep.ripgrep": "C:\\Users\\TU_USUARIO\\AppData\\Local\\Microsoft\\WinGet\\Packages\\BurntSushi.ripgrep.MSVC_Microsoft.Winget.Source_8wekyb3d8bbwe\\ripgrep-15.1.0-x86_64-pc-windows-msvc\\rg.exe",

  // ── Todo+ (checklist de tareas en archivos .todo) ────────────────────────
  // Colores Kanagawa para los .todo (los de fábrica son Monokai y desentonan).
  // La vista "Embedded" de Todo+ NO ve los objetos adt:// (sin disco), así que
  // para tags en el código usamos Todo Tree y dejamos Todo+ para el checklist.
  "todo.colors.done": "#98BB6C",
  "todo.colors.cancelled": "#C34043",
  "todo.colors.code": "#FFA066",
  "todo.colors.comment": "#727169",
  "todo.colors.project": "#7FB4CA",
  "todo.colors.projectStatistics": "#6A9589",
  "todo.colors.tag": "#E6C384",
  "todo.colors.tags.background": ["#E82424", "#FFA066", "#E6C384", "#957FB8"],
  "todo.colors.tags.foreground": ["#1F1F28", "#1F1F28", "#1F1F28", "#DCD7BA"],

  // ── WhichKey: popup de atajos (como which-key.nvim) ──────────────────────
  // Requiere la extensión VSpaceCode.whichkey. Se dispara con espacio en modo
  // normal (ver keybindings.json). Cada opción reenvía la secuencia a Neovim
  // (vscode-neovim.send), así los mappings del init.lua no se duplican: este
  // menú es solo la "carátula" visual. Si añadís un atajo nuevo en init.lua,
  // añadilo también aquí para que salga en el popup.
  "whichkey.delay": 0,
  "whichkey.sortOrder": "alphabetically",
  "whichkey.bindings": [
    { "key": " ", "name": "🗂️ Buscar archivos", "type": "command", "command": "vscode-neovim.send", "args": "<space><space>" },
    { "key": ",", "name": "📑 Todos los editores", "type": "command", "command": "vscode-neovim.send", "args": "<space>," },
    { "key": "e", "name": "🌲 Toggle explorador", "type": "command", "command": "vscode-neovim.send", "args": "<space>e" },
    { "key": "z", "name": "🧘 Modo Zen", "type": "command", "command": "vscode-neovim.send", "args": "<space>z" },
